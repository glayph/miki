# Copy this file to config/.env and fill provider credentials only on your machine.
# Local Gemma is the zero-API-cost default. Use an absolute path to the GGUF file.
SUPPORTED_MODELS=llama.cpp/gemma-4-E2B-it-Q4_0,gemini/gemma-4-e2b,gemini/gemini-3-flash-preview,openai/gpt-5-nano,opencode/your-model
MIKI_MODEL=llama.cpp/gemma-4-E2B-it-Q4_0
DEFAULT_MODEL=llama.cpp/gemma-4-E2B-it-Q4_0
MIKI_PROVIDER=llama.cpp
MIKI_LOCAL_MODEL_PATH=/absolute/path/to/gemma-4-E2B-it-Q4_0.gguf
MIKI_LLAMA_BASE_URL=http://127.0.0.1:39200/v1
MIKI_LLAMA_PORT=39200
MIKI_LOCAL_MAX_TOKENS=256
DEFAULT_MAX_TOKENS=256

# Optional remote fallback. Use gemini/gemma-4-e2b only after confirming
# that the active Gemini account exposes that model; the live provider catalog is authoritative.
MIKI_LOW_COST_MODEL=gemini/gemma-4-e2b

# Do not commit or share real values.
# GEMINI_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
