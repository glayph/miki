# Copy this file to config/.env and fill provider credentials only on your machine.
# Local Qwen Coder Q5_K_M is the zero-API-cost default. Use an absolute path to the GGUF file.
SUPPORTED_MODELS=llama.cpp/qwen2.5-coder-3b-instruct-q5_K_M,llama.cpp/gemma-4-E2B-it-Q4_0,gemini/gemma-4-e2b,gemini/gemini-3-flash-preview,openai/gpt-5-nano,opencode/your-model
MIKI_MODEL=llama.cpp/qwen2.5-coder-3b-instruct-q5_K_M
DEFAULT_MODEL=llama.cpp/qwen2.5-coder-3b-instruct-q5_K_M
MIKI_PROVIDER=llama.cpp
MIKI_LOCAL_MODEL_PATH=/absolute/path/to/qwen2.5-coder-3b-instruct-q5_k_m.gguf
# Set to 1 on an installed host to let Miki download/verify the allow-listed default model at startup.
MIKI_AUTO_INSTALL_LOCAL_MODEL=0
MIKI_LLAMA_BASE_URL=http://127.0.0.1:39200/v1
MIKI_LLAMA_PORT=39200
MIKI_LOCAL_CONTEXT_SIZE=8192
MIKI_LOCAL_LLM_TIMEOUT_MS=900000
MIKI_LOCAL_AGENT_RUN_TIMEOUT_MS=1800000
MIKI_LOCAL_MAX_TOKENS=256
DEFAULT_MAX_TOKENS=256

# Optional remote fallback. Use gemini/gemma-4-e2b only after confirming
# that the active Gemini account exposes that model; the live provider catalog is authoritative.
MIKI_LOW_COST_MODEL=gemini/gemma-4-e2b

# Do not commit or share real values.
# GEMINI_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
