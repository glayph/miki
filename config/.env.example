# Copy this file to config/.env and fill provider credentials only on your machine.
# Keep the default local model for zero API cost when a local llama.cpp model is available.
SUPPORTED_MODELS=llama.cpp/qwen2.5-0.5b-instruct-q4_k_m,gemini/gemma-4-e2b,gemini/gemini-3-flash-preview,openai/gpt-5-nano,opencode/your-model
MIKI_MODEL=llama.cpp/qwen2.5-0.5b-instruct-q4_k_m
DEFAULT_MODEL=llama.cpp/qwen2.5-0.5b-instruct-q4_k_m
MIKI_PROVIDER=llama.cpp

# Optional low-cost remote fallback. Use gemini/gemma-4-e2b only after confirming
# that the active Gemini account exposes that model; the live provider catalog is authoritative.
MIKI_LOW_COST_MODEL=gemini/gemma-4-e2b

# Do not commit or share real values.
# GEMINI_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
